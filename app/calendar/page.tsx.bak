'use client';

import { format, isSameDay, isSameMonth, addMonths, subMonths, startOfMonth, endOfMonth, eachDayOfInterval, isToday, formatDistanceToNow } from 'date-fns';
import { Calendar as CalendarIcon, Home, Plus, ChevronLeft, ChevronRight, Clock, BookOpen, AlertTriangle, AlertCircle, Calendar as Calendar, GripVertical, Menu, FileText } from 'lucide-react';
import Link from 'next/link';
import { useState, useCallback, useEffect, useRef } from 'react';
import { useClassContext, type Homework, type Attachment } from '@/context/ClassContext';
import { Tooltip, TooltipContent, TooltipProvider, TooltipTrigger } from '@/components/ui/tooltip';
import { Button } from '@/components/ui/button';
import { HomeworkDetailsModal } from '@/components/HomeworkDetailsModal';

// Touch device detection
const isTouchDevice = () => {
  if (typeof window === 'undefined') return false;
  return 'ontouchstart' in window || navigator.maxTouchPoints > 0;
};

type DragState = {
  isDragging: boolean;
  homeworkId: string | null;
  sourceDate: Date | null;
  currentHoverDate: Date | null;
};

// Custom hook for drag and drop
function useDragAndDrop(updateDueDate: (homeworkId: string, newDueDate: Date) => void) {
  const [dragState, setDragState] = useState<DragState>({
    isDragging: false,
    homeworkId: null,
    sourceDate: null,
    currentHoverDate: null
  });

  const handleDragStart = useCallback((e: React.DragEvent | React.TouchEvent, homeworkId: string, sourceDate: Date) => {
    // For mouse drag events
    if ('dataTransfer' in e) {
      e.dataTransfer.effectAllowed = 'move';
      e.dataTransfer.setData('text/plain', homeworkId);
    }
    
    setDragState({
      isDragging: true,
      homeworkId,
      sourceDate,
      currentHoverDate: null
    });
  }, []);

  const handleDragOver = useCallback((e: React.DragEvent, date: Date) => {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    
    setDragState(prev => ({
      ...prev,
      currentHoverDate: date
    }));
  }, []);

  const handleDrop = useCallback((e: React.DragEvent, targetDate: Date) => {
    e.preventDefault();
    
    if (dragState.homeworkId) {
      updateDueDate(dragState.homeworkId, targetDate);
    }
    
    setDragState({
      isDragging: false,
      homeworkId: null,
      sourceDate: null,
      currentHoverDate: null
    });
  }, [dragState.homeworkId, updateDueDate]);

  const handleDragEnd = useCallback(() => {
    setDragState({
      isDragging: false,
      homeworkId: null,
      sourceDate: null,
      currentHoverDate: null
    });
  }, []);

  return {
    dragState,
    handleDragStart,
    handleDragOver,
    handleDrop,
    handleDragEnd
  };
}

// Mobile swipe handling
const useSwipe = (onSwipeLeft: () => void, onSwipeRight: () => void) => {
  const touchStartX = useRef<number | null>(null);
  const touchEndX = useRef<number | null>(null);

  const onTouchStart = (e: TouchEvent) => {
    touchStartX.current = e.touches[0].clientX;
  };

  const onTouchMove = (e: TouchEvent) => {
    touchEndX.current = e.touches[0].clientX;
  };

  const onTouchEnd = () => {
    if (touchStartX.current === null || touchEndX.current === null) return;
    
    const diff = touchStartX.current - touchEndX.current;
    const swipeThreshold = 50; // Minimum swipe distance
    
    if (Math.abs(diff) > swipeThreshold) {
      if (diff > 0) {
        onSwipeLeft();
      } else {
        onSwipeRight();
      }
    }
    
    touchStartX.current = null;
    touchEndX.current = null;
  };

  useEffect(() => {
    const element = document.getElementById('calendar-grid');
    if (!element) return;
    
    element.addEventListener('touchstart', onTouchStart, { passive: true });
    element.addEventListener('touchmove', onTouchMove, { passive: true });
    element.addEventListener('touchend', onTouchEnd, { passive: true });
    
    return () => {
      element.removeEventListener('touchstart', onTouchStart);
      element.removeEventListener('touchmove', onTouchMove);
      element.removeEventListener('touchend', onTouchEnd);
    };
  }, [onSwipeLeft, onSwipeRight]);
};

export default function CalendarPage() {
  const { homeworks, classes, updateHomeworkDueDate, addAttachment, deleteAttachment } = useClassContext();
  const [currentMonth, setCurrentMonth] = useState<Date>(new Date());
  const [isSidebarOpen, setIsSidebarOpen] = useState(false);
  const [isMobile, setIsMobile] = useState(false);
  const [selectedHomework, setSelectedHomework] = useState<Homework | null>(null);
  
  // Set up mobile detection
  useEffect(() => {
    const handleResize = () => {
      setIsMobile(window.innerWidth < 768);
    };
    
    // Set initial value
    handleResize();
    
    // Add event listener
    window.addEventListener('resize', handleResize);
    
    // Clean up
    return () => window.removeEventListener('resize', handleResize);
  }, []);
  
  // Month navigation handlers
  const nextMonth = useCallback(() => {
    setCurrentMonth(addMonths(currentMonth, 1));
  }, [currentMonth]);

  const prevMonth = useCallback(() => {
    setCurrentMonth(subMonths(currentMonth, 1));
  }, [currentMonth]);

  const resetToToday = useCallback(() => {
    setCurrentMonth(new Date());
  }, []);
  
  // Swipe handlers
  useSwipe(nextMonth, prevMonth);
  
  const {
    dragState,
    handleDragStart,
    handleDragOver,
    handleDrop,
    handleDragEnd
  } = useDragAndDrop(updateHomeworkDueDate);

  // Get the start and end of the current month view
  const monthStart = startOfMonth(currentMonth);
  const monthEnd = endOfMonth(currentMonth);
  
  // Get all days in the month
  // Define the type for calendar day items
  interface CalendarDay {
    day: number;
    date: Date;
    homeworks: Homework[];
    isCurrentMonth: boolean;
    isToday: boolean;
  }

  const daysInMonth = eachDayOfInterval({
    start: monthStart,
    end: monthEnd,
  });
  
  // Get the first day of the month to calculate offset
  const firstDayOfMonth = monthStart.getDay(); // 0 = Sunday, 1 = Monday, etc.
  
  // Generate calendar days with empty slots for the start of the month
  const days: CalendarDay[] = [];
  const blankDays = Array(firstDayOfMonth).fill(null);
  
  daysInMonth.forEach(date => {
    const dayHomeworks = homeworks.filter(hw => 
      isSameDay(new Date(hw.dueDate), date)
    ) as Homework[];
    
    days.push({
      day: date.getDate(),
      date,
      homeworks: dayHomeworks,
      isCurrentMonth: isSameMonth(date, currentMonth),
      isToday: isToday(date)
    });
  });
  
  // Add days from next month to complete the last week
  const lastDayOfMonth = monthEnd.getDay();
  const daysToAdd = 6 - lastDayOfMonth; // Add days to complete the week
  
  for (let i = 1; i <= daysToAdd; i++) {
    const nextDate = new Date(monthEnd);
    nextDate.setDate(monthEnd.getDate() + i);
    days.push({
      day: nextDate.getDate(),
      date: nextDate,
      homeworks: [],
      isCurrentMonth: false,
      isToday: isToday(nextDate)
    });
  }
  
  // Get class color for homework items
  const getClassColor = (classId: string) => {
    const classItem = classes.find(c => c.id === classId);
    if (!classItem) return 'bg-gray-100';
    
    let hash = 0;
    for (let i = 0; i < classId.length; i++) {
      hash = classId.charCodeAt(i) + ((hash << 5) - hash);
    }
    const hue = Math.abs(hash) % 360;
    return `hsl(${hue}, 80%, 90%)`;
  };

  // Get due date status for homework items
  const getDueDateStatus = (dueDate: Date) => {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    
    const due = new Date(dueDate);
    due.setHours(0, 0, 0, 0);
    
    const diffDays = Math.floor((due.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
    
    if (diffDays < 0) return 'overdue';
    if (diffDays === 0) return 'today';
    if (diffDays === 1) return 'tomorrow';
    if (diffDays <= 7) return 'this-week';
    return 'upcoming';
  };

  // Get due date icon based on status
  const getDueDateIcon = (status: string) => {
    switch (status) {
      case 'overdue':
        return <AlertCircle className="h-3.5 w-3.5 text-red-500 mr-1" />;
      case 'today':
        return <AlertTriangle className="h-3.5 w-3.5 text-yellow-500 mr-1" />;
      case 'tomorrow':
      case 'this-week':
        return <Clock className="h-3.5 w-3.5 text-blue-500 mr-1" />;
      default:
        return <Calendar className="h-3.5 w-3.5 text-gray-500 mr-1" />;
    }
  };

  // Format due date for display
  const formatDueDate = (dueDate: Date) => {
    const status = getDueDateStatus(dueDate);
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    
    if (isSameDay(dueDate, today)) return 'Due today';
    
    const tomorrow = new Date(today);
    tomorrow.setDate(tomorrow.getDate() + 1);
    if (isSameDay(dueDate, tomorrow)) return 'Due tomorrow';
    
    if (status === 'overdue') {
      return `Overdue by ${Math.abs(Math.floor((today.getTime() - dueDate.getTime()) / (1000 * 60 * 60 * 24)))} days`;
    }
    
    return `Due ${formatDistanceToNow(dueDate, { addSuffix: true })}`;
  };

  // Toggle sidebar on mobile
  const toggleSidebar = () => {
    setIsSidebarOpen(!isSidebarOpen);
  };

  const handleAddAttachment = async (file: File) => {
    if (!selectedHomework) return;
    await addAttachment(selectedHomework.id, file);
  };

  const handleDeleteAttachment = (attachmentId: string) => {
    if (!selectedHomework) return;
    deleteAttachment(selectedHomework.id, attachmentId);
  };

  const handleHomeworkClick = (homework: Homework) => {
    setSelectedHomework(homework);
  };

  return (
    <div className="min-h-screen bg-gray-50 p-4 md:p-6">
      <HomeworkDetailsModal
        isOpen={!!selectedHomework}
        onClose={() => setSelectedHomework(null)}
        homework={selectedHomework}
        onAddAttachment={handleAddAttachment}
        onDeleteAttachment={handleDeleteAttachment}
      />
      <div className="max-w-6xl mx-auto">
        {/* Mobile Header */}
        <div className="md:hidden flex items-center justify-between mb-4">
          <button 
            onClick={toggleSidebar}
            className="p-2 rounded-md text-gray-700 hover:bg-gray-100"
            aria-label="Open menu"
          >
            <Menu className="h-6 w-6" />
          </button>
          <h1 className="text-xl font-bold text-gray-900">
            {format(currentMonth, 'MMMM yyyy')}
          </h1>
          <div className="w-10"></div> {/* Spacer for flex alignment */}
        </div>

        {/* Desktop Header */}
        <div className="hidden md:flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
          <div>
            <h1 className="text-2xl sm:text-3xl font-bold text-gray-900">
              {format(currentMonth, 'MMMM yyyy')}
            </h1>
            <p className="text-sm text-gray-500 mt-1">
              Viewing {format(monthStart, 'MMM d')} - {format(monthEnd, 'MMM d, yyyy')}
            </p>
          </div>
          
          <div className="flex items-center gap-2 w-full sm:w-auto">
            <div className="flex items-center border rounded-lg overflow-hidden bg-white shadow-sm">
              <button 
                onClick={prevMonth}
                className="p-2 hover:bg-gray-50 text-gray-700 transition-colors touch-manipulation"
                aria-label="Previous month"
              >
                <ChevronLeft className="h-5 w-5" />
              </button>
              
              <button 
                onClick={resetToToday}
                className="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors touch-manipulation"
              >
                Today
              </button>
              
              <button 
                onClick={nextMonth}
                className="p-2 hover:bg-gray-50 text-gray-700 transition-colors touch-manipulation"
                aria-label="Next month"
              >
                <ChevronRight className="h-5 w-5" />
              </button>
            </div>
            
            <Link 
              href="/" 
              className="hidden md:inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 whitespace-nowrap touch-manipulation"
            >
              <Home className="h-4 w-4 mr-2" />
              Back to Home
            </Link>
          </div>
        </div>
        
        <div className="relative">
          {/* Mobile month switcher */}
          {isMobile && (
            <div className="flex justify-between items-center mb-2">
              <button 
                onClick={prevMonth}
                className="p-2 text-gray-700 touch-manipulation"
                aria-label="Previous month"
              >
                <ChevronLeft className="h-5 w-5" />
              </button>
              <button 
                onClick={resetToToday}
                className="text-sm font-medium text-gray-700 px-3 py-1 bg-white rounded-md shadow-sm touch-manipulation"
              >
                Today
              </button>
              <button 
                onClick={nextMonth}
                className="p-2 text-gray-700 touch-manipulation"
                aria-label="Next month"
              >
                <ChevronRight className="h-5 w-5" />
              </button>
            </div>
          )}

          <div className="bg-white rounded-lg shadow overflow-hidden">
            <div id="calendar-grid" className="grid grid-cols-7 gap-px bg-gray-200 touch-manipulation">
              {['S', 'M', 'T', 'W', 'T', 'F', 'S'].map((day, index) => (
                <div key={index} className="bg-gray-100 py-2 text-center text-xs sm:text-sm font-medium text-gray-500">
                  {day}
                </div>
              ))}
              
              {blankDays.map((_, index) => (
                <div key={`blank-${index}`} className="h-16 sm:h-24 bg-white" />
              ))}
              
              {days.map(({ day, date, homeworks, isCurrentMonth, isToday }) => (
                <div 
                  key={date.toString()}
                  className={`relative min-h-16 sm:min-h-24 p-1 sm:p-2 border transition-colors ${
                    !isCurrentMonth ? 'bg-gray-50 text-gray-400' : 'bg-white'
                  } ${
                    isToday ? 'ring-2 ring-blue-500 ring-inset' : ''
                  } ${
                    dragState.currentHoverDate && isSameDay(dragState.currentHoverDate, date) 
                      ? 'ring-2 ring-blue-400 bg-blue-50' 
                      : 'border-gray-100'
                  }`}
                  onDragOver={(e) => handleDragOver(e, date)}
                  onDrop={(e) => handleDrop(e, date)}
                  onTouchStart={isTouchDevice() ? (e: React.TouchEvent) => {
                    // Prevent default to avoid scrolling while dragging
                    if (e.cancelable) e.preventDefault();
                    handleDragStart(e, '', date);
                  } : undefined}
                  onTouchEnd={isTouchDevice() ? () => {
                    if (dragState.isDragging && dragState.homeworkId && dragState.currentHoverDate) {
                      updateHomeworkDueDate(dragState.homeworkId, dragState.currentHoverDate);
                    }
                    handleDragEnd();
                  } : undefined}
                >
                  <div className="flex justify-between items-start">
                    <span className={`inline-flex items-center justify-center w-5 h-5 sm:w-6 sm:h-6 rounded-full text-xs sm:text-sm font-medium ${
                      isToday 
                        ? 'bg-blue-600 text-white' 
                        : !isCurrentMonth 
                          ? 'text-gray-400' 
                          : 'text-gray-900'
                    }`}>
                      {day}
                    </span>
                    {isSameDay(date, new Date()) && (
                      <span className="hidden sm:inline-flex text-[10px] sm:text-xs px-1.5 sm:px-2 py-0.5 rounded-full bg-blue-100 text-blue-800">
                        Today
                      </span>
                    )}
                  </div>
                  
                  <div className="mt-1 space-y-0.5 sm:space-y-1 max-h-16 sm:max-h-20 overflow-y-auto touch-pan-y">
                    <TooltipProvider>
                      {homeworks.map(hw => {
                        const classInfo = classes.find(c => c.id === hw.classId);
                        if (!classInfo) return null;
                        
                        const dueDate = new Date(hw.dueDate);
                        const status = getDueDateStatus(dueDate);
                        const statusIcon = getDueDateIcon(status);
                        const dueDateText = formatDueDate(dueDate);
                        const formattedDueDate = format(dueDate, 'MMM d, yyyy');
                        
                        return (
                          <div key={hw.id} className="group relative">
                            <Tooltip>
                              <TooltipTrigger asChild>
                                <div 
                                  className={`text-xs p-1 sm:p-1.5 rounded truncate transition-all duration-200 hover:shadow-md hover:z-10 hover:scale-[1.02] ${
                                    isTouchDevice() ? 'active:scale-95' : 'cursor-move'
                                  } ${dragState.homeworkId === hw.id ? 'opacity-50' : ''}`}
                                  style={{ backgroundColor: getClassColor(hw.classId) }}
                <div className="mt-1 space-y-0.5 sm:space-y-1 max-h-16 sm:max-h-20 overflow-y-auto touch-pan-y">
                  <TooltipProvider>
                    {homeworks.map(hw => {
                      const classInfo = classes.find(c => c.id === hw.classId);
                      if (!classInfo) return null;
                      
                      const dueDate = new Date(hw.dueDate);
                      const status = getDueDateStatus(dueDate);
                      const statusIcon = getDueDateIcon(status);
                      const dueDateText = formatDueDate(dueDate);
                      const formattedDueDate = format(dueDate, 'MMM d, yyyy');
                      
                      return (
                        <div key={hw.id} className="group relative">
                          <Tooltip>
                            <TooltipTrigger asChild>
                              <div 
                                className={`text-xs p-1 sm:p-1.5 rounded truncate transition-all duration-200 hover:shadow-md hover:z-10 hover:scale-[1.02] ${
                                  isTouchDevice() ? 'active:scale-95' : 'cursor-move'
                                } ${dragState.homeworkId === hw.id ? 'opacity-50' : ''}`}
                                style={{ backgroundColor: getClassColor(hw.classId) }}
                                draggable={!isTouchDevice()}
                                onDragStart={!isTouchDevice() ? (e) => handleDragStart(e, hw.id, new Date(hw.dueDate)) : undefined}
                                onDragEnd={!isTouchDevice() ? handleDragEnd : undefined}
                                onTouchStart={isTouchDevice() ? (e) => {
                                  e.stopPropagation();
                                  handleDragStart(e, hw.id, new Date(hw.dueDate));
                                } : undefined}
                                onClick={() => handleHomeworkClick(hw)}
                              >
                                <div className="flex items-center">
                                  <GripVertical className={`h-3 w-3 mr-0.5 sm:mr-1 opacity-50 ${isTouchDevice() ? 'hidden' : ''}`} />
                                  <div className="h-5 w-5 sm:h-6 sm:w-6 rounded-full flex-shrink-0 flex items-center justify-center mr-1" style={{ backgroundColor: getClassColor(hw.classId) }}>
                                    <span className="text-[10px] sm:text-xs font-medium text-gray-800">
                                      {classInfo.name.split(' ').map(n => n[0]).join('').toUpperCase()}
                                    </span>
                                  </div>
                                  <div className="ml-1 flex-1 min-w-0">
                                    <h4 className="text-sm font-medium text-gray-900 truncate">{hw.title}</h4>
                                    <div className="flex items-center text-xs text-gray-500">
                                      <span className="truncate">{classInfo.name}</span>
                                    </div>
                                    <div className="flex items-center text-xs text-gray-500">
                                      <span>Due {formattedDueDate}</span>
                                    </div>
                                  </div>
                                  <div className="ml-2 flex-shrink-0">
                                    <span className="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-white bg-opacity-50">
                                      {hw.attachments?.length || 0}
                                    </span>
                                  </div>
                                </div>
                              </div>
                            </TooltipTrigger>
                            <TooltipContent className="max-w-xs p-0" side="right">
                              <div className="p-3">
                                <div className="flex items-center mb-2">
                                  <div 
                                    className="h-8 w-8 rounded-full flex-shrink-0 flex items-center justify-center mr-2" 
                                    style={{ backgroundColor: getClassColor(hw.classId) }}
                                  >
                                    <span className="text-xs font-medium text-gray-800">
                                      {classInfo.name.split(' ').map(n => n[0]).join('').toUpperCase()}
                                    </span>
                                  </div>
                                  <div>
                                    <h4 className="font-medium">{hw.title}</h4>
                                    <p className="text-sm text-gray-600">{classInfo.name}</p>
                                  </div>
                                </div>
                                <div className="space-y-2 text-sm">
                                  <div className="flex items-center">
                                    <Calendar className="h-4 w-4 mr-2 text-gray-400" />
                                    <span>Due {formattedDueDate}</span>
                                  </div>
                                  <div className="flex items-center">
                                    {statusIcon}
                                    <span className="ml-2">{dueDateText}</span>
                                  </div>
                                  <div className="flex items-center">
                                    <FileText className="h-4 w-4 mr-2 text-gray-400" />
                                    <span>{hw.attachments?.length || 0} {hw.attachments?.length === 1 ? 'attachment' : 'attachments'}</span>
                                  </div>
                                </div>
                                <Button 
                                  variant="outline" 
                                  size="sm" 
                                  className="w-full mt-3"
                                  onClick={(e) => {
                                    e.stopPropagation();
                                    handleHomeworkClick(hw);
                                  }}
                                >
                                  View Details
                                </Button>
                              </div>
                            </TooltipContent>
                          </Tooltip>
                        </div>
                      );
                    })}
                  </TooltipProvider>
                </div>
